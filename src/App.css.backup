.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(39, 190, 139, 0.18), transparent 30%),
    radial-gradient(circle at 80% 75%, rgba(44, 129, 222, 0.18), transparent 32%),
    linear-gradient(135deg, #071b19 0%, #0a2425 48%, #071a29 100%);
  color: #fff;
}

.container {
  position: relative;
  z-index: 3;
  width: min(100% - 32px, 720px);
  min-height: 100vh;
  margin: 0 auto;
  padding: 58px 0 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Decorative background */

.page::before,
.page::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(10px);
}

.page::before {
  width: 420px;
  height: 420px;
  top: -180px;
  left: -180px;
  background: rgba(27, 204, 143, 0.12);
}

.page::after {
  width: 460px;
  height: 460px;
  right: -220px;
  bottom: -220px;
  background: rgba(39, 133, 224, 0.13);
}

.background-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.background-glow-one {
  width: 7px;
  height: 7px;
  top: 16%;
  left: 13%;
  background: #45dca8;
  box-shadow: 0 0 18px rgba(69, 220, 168, 0.8);
}

.background-glow-two {
  width: 5px;
  height: 5px;
  top: 28%;
  right: 15%;
  background: #66b7ff;
  box-shadow: 0 0 16px rgba(102, 183, 255, 0.8);
}

/* Profile */

.profile-header {
  text-align: center;
  margin-bottom: 34px;
}

.profile-logo {
  width: 132px;
  height: 132px;
  margin: 0 auto 22px;
  padding: 5px;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 34px;
  background: rgba(255, 255, 255, 0.08);
  box-shadow:
    0 20px 55px rgba(0, 0, 0, 0.35),
    0 0 35px rgba(40, 199, 145, 0.12);
  backdrop-filter: blur(12px);
  transform: rotate(-2deg);
  transition: transform 220ms ease;
}

.profile-logo:hover {
  transform: rotate(0deg) translateY(-4px);
}

.profile-logo img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 29px;
  object-fit: cover;
}

.profile-header h1 {
  margin: 0;
  color: #fff;
  font-size: clamp(2.3rem, 8vw, 3.5rem);
  line-height: 1;
  font-weight: 850;
  letter-spacing: -2px;
  text-shadow: 0 5px 25px rgba(0, 0, 0, 0.3);
}

.profile-description {
  margin: 11px 0 0;
  color: #72e2ba;
  font-size: 1.05rem;
  font-weight: 700;
}

.profile-tagline {
  margin: 6px 0 0;
  color: rgba(235, 249, 246, 0.62);
  font-size: 0.92rem;
}

/* Social icons */

.social-links {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 22px;
  margin: 8px 0 32px;
}

.social-link {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  color: #fff;
  transition:
    transform 200ms ease,
    color 200ms ease;
}

.social-link:hover {
  transform: translateY(-8px);
}

.social-link-icon {
  width: 72px;
  height: 72px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.045)
    );
  box-shadow:
    0 14px 30px rgba(0, 0, 0, 0.22),
    inset 0 1px rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  font-size: 1.7rem;
  transition:
    border-color 200ms ease,
    box-shadow 200ms ease,
    background 200ms ease;
}

.social-link:hover .social-link-icon {
  border-color: rgba(103, 226, 187, 0.65);
  background:
    linear-gradient(
      145deg,
      rgba(62, 207, 157, 0.22),
      rgba(57, 139, 213, 0.13)
    );
  box-shadow:
    0 18px 36px rgba(0, 0, 0, 0.3),
    0 0 25px rgba(55, 205, 157, 0.16);
}

.social-link-label {
  color: rgba(239, 250, 247, 0.68);
  font-size: 0.73rem;
  font-weight: 650;
  transition: color 200ms ease;
}

.social-link:hover .social-link-label {
  color: #fff;
}

/* Main store action */

.social-links + .whatsapp-button {
  margin-top: 2px;
}

.whatsapp-button {
  width: min(100%, 460px);
  min-height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  padding: 13px 24px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 21px;
  color: #fff;
  background:
    linear-gradient(
      135deg,
      rgba(39, 187, 137, 0.85),
      rgba(30, 127, 202, 0.82)
    );
  box-shadow:
    0 16px 35px rgba(0, 0, 0, 0.27),
    0 0 35px rgba(34, 187, 139, 0.12);
  backdrop-filter: blur(10px);
  font-weight: 800;
  transition:
    transform 200ms ease,
    box-shadow 200ms ease;
}

.whatsapp-button svg {
  font-size: 1.5rem;
}

.whatsapp-button:hover {
  transform: translateY(-4px);
  box-shadow:
    0 21px 40px rgba(0, 0, 0, 0.32),
    0 0 40px rgba(34, 187, 139, 0.2);
}

/* Footer */

.footer {
  margin-top: auto;
  padding-top: 48px;
  text-align: center;
}

.footer a {
  color: rgba(225, 243, 239, 0.42);
  font-size: 0.76rem;
  transition: color 180ms ease;
}

.footer a:hover {
  color: rgba(225, 243, 239, 0.8);
}

/* Mobile */

@media (max-width: 520px) {
  .container {
    width: min(100% - 24px, 720px);
    padding-top: 42px;
  }

  .profile-logo {
    width: 112px;
    height: 112px;
    border-radius: 29px;
  }

  .profile-logo img {
    border-radius: 24px;
  }

  .profile-header h1 {
    font-size: 2.45rem;
  }

  .social-links {
    gap: 12px;
  }

  .social-link-icon {
    width: 62px;
    height: 62px;
    border-radius: 20px;
    font-size: 1.45rem;
  }

  .social-link-label {
    font-size: 0.68rem;
  }

  .whatsapp-button {
    width: 100%;
  }
}

@media (max-width: 360px) {
  .social-links {
    gap: 8px;
  }

  .social-link-icon {
    width: 57px;
    height: 57px;
  }
}
